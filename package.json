{
  "name": "docsgen-framework",
  "version": "0.1.0",
  "description": "A reusable Docusaurus 3 help-center framework: user guides, per-endpoint API reference, screenshot and video tooling, prose and structure linting, an incremental docs-generation pipeline, and a printable PDF manual.",
  "//": "private: this is a clone-and-own TEMPLATE repository, not an npm package. Adopters press 'Use this template' (or clone) and own the result — see the adoption checklist in README.md. Releases are git tags, not npm versions.",
  "private": true,
  "license": "MIT",
  "author": "Venkateswarlu Gantena <vgantena@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vgantena/docsgen-framework.git"
  },
  "homepage": "https://github.com/vgantena/docsgen-framework#readme",
  "bugs": {
    "url": "https://github.com/vgantena/docsgen-framework/issues"
  },
  "keywords": [
    "docusaurus",
    "documentation",
    "docs-as-code",
    "help-center",
    "api-reference",
    "openapi",
    "technical-writing",
    "screenshots",
    "playwright",
    "vale"
  ],
  "scripts": {
    "doctor": "node tools/doctor.mjs",
    "init-product": "node tools/init-product.mjs",
    "drop-sample": "node tools/drop-sample.mjs",
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "capture": "node tools/capture.mjs",
    "record": "node tools/record.mjs",
    "login": "node tools/login.mjs",
    "media": "node tools/media.mjs",
    "media:optimize": "node tools/optimize-images.mjs",
    "audit:selectors": "node tools/audit-selectors.mjs",
    "pdf": "node tools/build-pdf.mjs",
    "docgen:plan": "node tools/docgen-plan.mjs",
    "docgen:kb-export": "node tools/docgen-kb-export.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "brand-assets": "node tools/make-brand-assets.mjs",
    "lint:md": "markdownlint-cli2",
    "lint:prose": "vale docs templates",
    "lint:js": "eslint tools tests eslint.config.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "markdownlint-cli2": "^0.23.2",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=22.0"
  }
}
