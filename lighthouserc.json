{
  "ci": {
    "collect": {
      "staticDistDir": "build",
      "url": ["/", "/guides/items/", "/developers/items-api/"],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", {"minScore": 0.9}]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
