# Copy to .env (gitignored). Machine/environment-specific values ONLY —
# the pipeline definition itself lives in docgen.config.json (committed).

# Target app for screenshots (npm run capture) and videos (npm run record).
# Read by tools/capture.mjs and tools/record.mjs; --base still wins.
APP_URL=http://localhost:3000

# Demo credentials — available to recording flows as process.env.DEMO_USER /
# process.env.DEMO_PASS. Seeded demo data only, never real accounts.
DEMO_USER=
DEMO_PASS=

# Authenticated screenshots/videos use a storage-state file created by
# `npm run login` (drives tools/flows/login.mjs with the credentials above,
# saves auth.json — gitignored):
#   npm run login
#   npm run capture -- --url / --out static/img/x.png --storage-state auth.json

# KB export (npm run docgen:kb-export -- --write) — a platform account with
# support-triage rights on the product's platform API. Plan/dry-run needs none.
KB_BASE_URL=http://localhost
KB_USER=
KB_PASS=
