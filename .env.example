# Copy to .env (gitignored). Machine/environment-specific values ONLY —
# the pipeline definition itself lives in docgen.config.json (committed).

# Target app for screenshots (npm run capture) and videos (npm run record).
# Read by tools/capture.mjs and tools/record.mjs; --base still wins.
APP_URL=http://localhost:3000

# Demo credentials — available to recording flows as process.env.DEMO_USER /
# process.env.DEMO_PASS. Seeded demo data only, never real accounts.
DEMO_USER=
DEMO_PASS=
